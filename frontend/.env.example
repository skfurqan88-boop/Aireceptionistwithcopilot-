# Frontend Environment Variables for Vercel

# Backend API URL (Required)
# This should point to your deployed backend API
# Examples:
# - Railway: https://your-app.railway.app
# - Render: https://your-app.onrender.com
# - Custom domain: https://api.yourdomain.com
# - For local development: http://localhost:8000
REACT_APP_API_URL=https://your-backend-api-url.com

# Note: In Vercel, you need to add this environment variable in:
# Project Settings > Environment Variables
#
# Make sure to:
# 1. Remove the trailing slash from the URL
# 2. Use HTTPS for production
# 3. Update CORS settings in your backend to allow your Vercel domain
